{
  "Header Link": {
    "prefix": [
      "hl"
    ],
    "body": [
      "<h$1 id=\"$2\">",
      "  <a href=\"#$2\">",
      "    ${3:$TM_SELECTED_TEXT}",
      "  </a>",
      "</h$1>",
      "$0"
    ],
    "description": "Header links"
  },
  "Documentation Frontmatter": {
    "prefix": "dfmt",
    "body": [
      "---",
      "title: $1$TM_FILENAME_BASE",
      "permalink: /$2$TM_FILENAME_BASE/",
      "---"
    ],
    "description": "Documentation frontmatter"
  },
  "date-ymd": {
    "prefix": [
      "date",
      "date-y"
    ],
    "body": [
      "${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}"
    ],
    "description": "Current date in yyyy-mm-dd"
  },
  "syntax for markdown": {
    "prefix": "syn",
    "body": [
      "\\`\\`\\`${1}",
      "${2:$TM_SELECTED_TEXT}",
      "\\`\\`\\`$0"
    ],
    "description": "syntax for markdown"
  },
  "Metadata": {
    "prefix": "meta",
    "body": [
      "---",
      "title: ${1}",
      "date: \"${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}T${CURRENT_HOUR}:${CURRENT_MINUTE}:${CURRENT_SECOND}\"",
      "description: ${2}",
      "---",
      "${0}"
    ],
    "description": "Metadata"
  },
  "Links for markdown": {
    "prefix": "link",
    "body": [
      "[${1:#text}](${2:#link})${0}"
    ],
    "description": "Links for markdown"
  },
  "EMTLevel snippet": {
    "prefix": "emt",
    "body": [
      "<EMTLevel level=\"$1\"${2: medControl=${3:{true}}}>",
      "  ${4:$TM_SELECTED_TEXT}",
      "</EMTLevel>"
    ],
    "description": "EMTLevel snippet"
  },
  "H tags": {
    "prefix": "hl",
    "body": [
      "<h$1 id=\"$2\">",
      "  <a href=\"#$2\">",
      "    ${3:$TM_SELECTED_TEXT}",
      "  </a>",
      "</h$1>"
    ],
    "description": "H tags"
  },
  "liquid tags": {
    "prefix": "lq",
    "body": [
      "{{ $1 }}$0"
    ],
    "description": "liquid tags"
  },
  "liquid variable": {
    "prefix": "lqv",
    "body": [
      "{{ assign $1 }}$0"
    ],
    "description": "liquid variable"
  }
}
