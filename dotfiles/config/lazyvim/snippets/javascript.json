{
  "jsdoc": {
    "prefix": [
      "jsdoc"
    ],
    "body": [
      "/**",
      " * $1",
      " */"
    ],
    "description": "jsdoc"
  },
  "jsdoc inline": {
    "prefix": [
      "jsdoci"
    ],
    "body": [
      "/** $1 */"
    ],
    "description": "JSDOC inline"
  },
  "dirname": {
    "prefix": [
      "dirname"
    ],
    "body": [
      "import * as url from 'url';",
      "const __dirname = url.fileURLToPath(new URL('.', import.meta.url));"
    ],
    "description": "Adds __dirname to an ESM file."
  },
  "filename": {
    "prefix": [
      "filename"
    ],
    "body": [
      "import * as url from 'url';",
      "const __filename = url.fileURLToPath(new URL(import.meta.url));"
    ],
    "description": "Adds __filename to an ESM file."
  },
  "require statement": {
    "prefix": "req",
    "body": [
      "const $1 = require(\"$2\")"
    ],
    "description": "require statement"
  },
  "import default": {
    "prefix": "im",
    "body": [
      "import $1 from \"$2\";$0"
    ],
    "description": "import default"
  },
  "import named exports": {
    "prefix": "imb",
    "body": [
      "import { $1 } from \"$2\";$0"
    ],
    "description": "import named exports"
  },
  "export default": {
